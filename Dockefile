# 使用官方轻量级 Python 镜像
FROM python:3.9-slim

# 设置工作目录
WORKDIR /main

# 复制依赖文件并安装
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制当前目录下所有文件到容器
COPY . .

# 赋予所有文件权限 (解决 HFS 的 Permission Denied 问题)
RUN chmod -R 777 /main

# 暴露 HF 规定的端口
EXPOSE 7860

# 启动命令
CMD ["python", "main.py"]
